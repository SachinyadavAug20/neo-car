# ─── DRIFT — A Paper World ─── Environment Variables ───
# Copy this file to .env.local and fill in values

# App Info
NEXT_PUBLIC_APP_NAME="DRIFT — A Paper World"
NEXT_PUBLIC_APP_URL="https://drift-paper.vercel.app"

# Site Metadata
NEXT_PUBLIC_SITE_TITLE="DRIFT — A Paper World"
NEXT_PUBLIC_SITE_DESCRIPTION="An interactive 3D paper craft storytelling experience"

# Analytics (optional)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_VERCEL_ANALYTICS="true"

# Feature Flags
NEXT_PUBLIC_ENABLE_AUDIO="true"
NEXT_PUBLIC_ENABLE_CURSOR="true"
NEXT_PUBLIC_ENABLE_SECRET_WORDS="true"
NEXT_PUBLIC_ENABLE_DEBUG_TERMINAL="true"

# Performance
NEXT_PUBLIC_DPR_MAX="1.5"
NEXT_PUBLIC_SHADOW_MAP_SIZE="2048"

# Debug (set to false in production)
NEXT_PUBLIC_DEBUG="false"
